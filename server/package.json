{
  "name": "@sweety/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch index.js",
    "start": "node --env-file-if-exists=../.env index.js",
    "db:migrate": "node --env-file-if-exists=../.env db/migrate.js",
    "db:seed": "node --env-file-if-exists=../.env db/seed.js",
    "test": "node --env-file-if-exists=../.env --run test:api",
    "test:api": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
